# Credenciales de la plataforma. Copia a `.env` (de este repo o de su carpeta padre).
#
# SUPABASE_SERVICE_KEY se salta el RLS y es la única que puede escribir: solo lado
# Python, NUNCA en un frontend.
#
# Sin estas variables el SDK no se queja: trata "sin credenciales" como su modo normal y
# escribe solo a disco. Por eso `scripts/palletize.py` imprime siempre en qué modo va.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
